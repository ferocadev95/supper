# --- NextAuth / Auth.js ---
# Secreto para firmar los JWT de sesión. Obligatorio con la estrategia "jwt".
# Genera uno con: npx auth secret   (o) openssl rand -base64 32
AUTH_SECRET=

# URL base pública de la app. Se usa para construir los enlaces de los correos
# (verificación de cuenta y recuperación de contraseña) y por NextAuth.
# En local: http://localhost:3000
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (envío de correos: verificación de email y recuperación de contraseña)
AUTH_RESEND_KEY=

# Remitente de los correos. En producción usa tu dominio verificado.
# En dev sin dominio verificado, usa onboarding@resend.dev (solo puede enviar
# al correo con el que creaste tu cuenta de Resend). Además, fuera de producción
# el enlace de verificación/reset también se imprime en la consola del servidor.
EMAIL_FROM=onboarding@resend.dev

# --- Firebase Admin (server) ---
# JSON del service account en una sola línea (string).
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Firebase client (público) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Stripe ---
STRIPE_SECRET_KEY=

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=

# --- Búsqueda en vivo del navbar ---
# Todas son opcionales: sin definirlas, la búsqueda en vivo va encendida con
# los valores por defecto. Están aquí para poder frenarla si el tráfico crece.
# `off` apaga el desplegable de sugerencias (el buscador sigue funcionando por
# formulario); cualquier otro valor lo deja encendido.
NEXT_PUBLIC_LIVE_SEARCH=
# Caracteres mínimos antes de consultar (por defecto 2). Subirlo recorta las
# búsquedas más caras y menos útiles.
NEXT_PUBLIC_LIVE_SEARCH_MIN_CHARS=
# Espera tras la última pulsación, en ms (por defecto 250). Subirlo agrupa más
# pulsaciones en una sola petición.
NEXT_PUBLIC_LIVE_SEARCH_DEBOUNCE_MS=
# Sugerencias visibles en el desplegable (por defecto 6).
NEXT_PUBLIC_LIVE_SEARCH_LIMIT=
# Segundos que se reutiliza el catálogo cacheado en /api/search (por defecto
# 300). Subirlo abarata el endpoint a cambio de reflejar más tarde los cambios
# de precio o las altas de producto.
NEXT_PUBLIC_LIVE_SEARCH_REVALIDATE_SECONDS=

# --- Pick & Go (recolección en sucursal) ---
# Opcional. Sin definir, Pick & Go está APAGADO: el carrito sólo ofrece entrega
# a domicilio y /api/checkout rechaza cualquier otro método. `on` lo reactiva.
NEXT_PUBLIC_PICKUP=
